# CI-only environment, copied to .env by .github/actions/setup. Every value here is a
# throwaway for the disposable containers in infra/docker-compose.dev.yml — never a real secret.
NODE_ENV=test
LOG_LEVEL=warn
NEXT_TELEMETRY_DISABLED=1
PRISMA_HIDE_UPDATE_MESSAGE=1

APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Only the tmpfs test database runs in CI; migrations and the drift check use it too.
DATABASE_URL=postgresql://ins:ins@localhost:5433/ins
DIRECT_DATABASE_URL=postgresql://ins:ins@localhost:5433/ins
TEST_DATABASE_URL=postgresql://ins:ins@localhost:5433/ins
SHADOW_DATABASE_URL=postgresql://ins:ins@localhost:5433/ins_shadow

REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379/15

BETTER_AUTH_SECRET=ci-only-placeholder-not-a-secret-000000
BETTER_AUTH_URL=http://localhost:3000
HIBP_ENABLED=false

REALTIME_JWT_SECRET=ci-only-placeholder-not-a-secret-000000
REALTIME_JWT_SECRET_PREVIOUS=
REALTIME_PORT=4001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_UPLOADS=ins-uploads
S3_BUCKET_MEDIA=ins-media
S3_BUCKET_EXPORTS=ins-exports
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/ins-media

RESEND_API_KEY=
EMAIL_FROM="INS <no-reply@localhost>"
SMTP_URL=smtp://localhost:1025

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

WORKER_CONCURRENCY_MEDIA=2
NSFW_REJECT_THRESHOLD=0.85
NSFW_REVIEW_THRESHOLD=0.6

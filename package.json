{
  "name": "ins",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "infra:up": "infra/scripts/compose.sh up -d --wait --wait-timeout 60 && infra/scripts/compose.sh run --rm minio-init",
    "infra:down": "infra/scripts/compose.sh down",
    "infra:logs": "infra/scripts/compose.sh logs -f --tail=100",
    "db:migrate": "pnpm --filter @ins/db db:migrate",
    "db:deploy": "pnpm --filter @ins/db db:deploy",
    "db:reset": "pnpm --filter @ins/db db:reset",
    "db:seed": "pnpm --filter @ins/db db:seed",
    "db:studio": "pnpm --filter @ins/db db:studio",
    "db:generate": "pnpm --filter @ins/db db:generate",
    "db:drift": "pnpm --filter @ins/db db:drift"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}

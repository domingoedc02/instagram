# Copy to .env at the repo root: `cp .env.example .env`, then fill in the two secrets.
# Every variable is documented in spec/setup (Environment variables).

NODE_ENV=development
LOG_LEVEL=debug

# --- App -------------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API and the realtime server.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------------------
# App traffic goes through PgBouncer (transaction pooling).
DATABASE_URL=postgresql://ins:ins@localhost:6432/ins?pgbouncer=true
# Migrations connect directly; they cannot run through PgBouncer.
DIRECT_DATABASE_URL=postgresql://ins:ins@localhost:5432/ins
# Integration tests (pnpm test:int), tmpfs-backed.
TEST_DATABASE_URL=postgresql://ins:ins@localhost:5433/ins
# Scratch database for `pnpm db:drift` (Prisma replays migrations into it and compares).
SHADOW_DATABASE_URL=postgresql://ins:ins@localhost:5433/ins_shadow

# --- Redis -------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
HIBP_ENABLED=false

# --- Realtime ----------------------------------------------------------------------------
# openssl rand -base64 32
REALTIME_JWT_SECRET=
REALTIME_JWT_SECRET_PREVIOUS=
REALTIME_PORT=4001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# --- Object storage (MinIO locally) ------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_UPLOADS=ins-uploads
S3_BUCKET_MEDIA=ins-media
S3_BUCKET_EXPORTS=ins-exports
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/ins-media

# --- Email -------------------------------------------------------------------------------
# Leave RESEND_API_KEY empty in dev: mail goes to Mailpit over SMTP (UI: http://localhost:8025).
RESEND_API_KEY=
EMAIL_FROM="INS <no-reply@localhost>"
SMTP_URL=smtp://localhost:1025

# --- Observability -----------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Worker ------------------------------------------------------------------------------
WORKER_CONCURRENCY_MEDIA=2
NSFW_REJECT_THRESHOLD=0.85
NSFW_REVIEW_THRESHOLD=0.6

# --- Local port overrides (infra/docker-compose.dev.yml) ---------------------------------
# Uncomment when a default host port is already taken, and update the URLs above to match.
# INS_POSTGRES_PORT=5432
# INS_POSTGRES_TEST_PORT=5433
# INS_PGBOUNCER_PORT=6432
# INS_REDIS_PORT=6379
# INS_MINIO_PORT=9000
# INS_MINIO_CONSOLE_PORT=9001
# INS_SMTP_PORT=1025
# INS_MAILPIT_PORT=8025

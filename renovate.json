{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "One weekly PR for all non-major npm updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch"
    },
    {
      "description": "Actions stay pinned by SHA; digest bumps are grouped.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Prisma CLI and client must move together.",
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "prisma"
    },
    {
      "description": "Majors get their own PR and a human decision.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
